# Supabase (web auth + sync client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Deployment-only secret for server routes such as CLI token exchange.
# Never commit a real value to git. Keep it only in your hosting provider's secret manager.
# SUPABASE_SERVICE_ROLE_KEY=

# CLI-only (same values OK; avoids loading Next bundle). Falls back to NEXT_PUBLIC_* when unset:
# HYDROLOOP_SUPABASE_URL=
# HYDROLOOP_SUPABASE_ANON_KEY=
# Optional non-interactive login: HYDROLOOP_PASSWORD=
# Optional CLI config directory (defaults to ~/.config/hydroloop):
# HYDROLOOP_CONFIG_DIR=

# Cloudinary: for custom reminder sound uploads (unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET
